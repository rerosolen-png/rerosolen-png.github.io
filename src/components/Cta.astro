---
/**
 * Chamada para ação (orçamento pelo WhatsApp + visita à loja).
 * Usada no fim das páginas de tecido, categoria e artigos.
 */
import { site, whatsappLink, telLink } from '../data/site';
import IconWhatsApp from './icons/IconWhatsApp.astro';

export interface Props {
  title?: string;
  text?: string;
  /** Mensagem inicial do WhatsApp, ex.: "Olá! Quero um orçamento de Tricoline." */
  message?: string;
}
const {
  title = 'Precisa de ajuda para escolher o tecido certo?',
  text = `Fale com a equipe da ${site.name} pelo WhatsApp ou visite a loja em ${site.address.city}. Vendemos por metro, com corte na hora e orientação para o seu projeto.`,
  message,
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta__inner">
    <div>
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__actions">
      <a
        class="btn btn--whatsapp btn--lg"
        href={whatsappLink(message)}
        target="_blank"
        rel="noopener noreferrer"
      >
        <IconWhatsApp />
        <span>Pedir orçamento no WhatsApp</span>
      </a>
      <a class="btn btn--light" href={telLink()}>
        Ligar {site.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    margin-top: 3.5rem;
    background: var(--color-primary);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 4vw, 3rem);
  }
  .cta__inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .cta__inner {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .cta h2 {
    color: #fff;
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }
  .cta p {
    margin: 0;
    color: #d8e0ec;
  }
  .cta__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: stretch;
  }
  @media (min-width: 900px) {
    .cta__actions {
      align-items: flex-end;
    }
  }
</style>
