---
/**
 * Logotipo em SVG inline (texto + marca). Substitua pelo logo oficial quando disponível,
 * mantendo o `aria-label` para acessibilidade.
 */
export interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<span class:list={['logo', { 'logo--light': light }]} role="img" aria-label="Rosolen Textil">
  <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <rect x="2" y="2" width="44" height="44" rx="10" fill="currentColor" opacity="0.12"></rect>
    <path
      d="M12 36V12h11.5c5 0 8.5 2.8 8.5 7.2 0 3.3-2 5.7-5.2 6.6L34 36h-5.6l-6.3-9.3h-5V36H12zm5.1-13.6h5.9c2.8 0 4.4-1.3 4.4-3.3s-1.6-3.3-4.4-3.3h-5.9v6.6z"
      fill="currentColor"></path>
    <path d="M6 42c6-3 12-3 18 0s12 3 18 0" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__name">Rosolen</span>
    <span class="logo__sub">Textil</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-primary-dark);
  }
  .logo--light {
    color: #fff;
  }
  .logo__mark {
    width: 42px;
    height: 42px;
    flex: none;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo__name {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .logo__sub {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: 0.2rem;
  }
  .logo--light .logo__sub {
    color: #f3c7b3;
  }
</style>
