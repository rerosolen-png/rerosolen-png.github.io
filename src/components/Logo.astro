---
/**
 * Logotipo oficial da Rosolen Têxtil.
 *
 * Os arquivos public/logo.svg (azul-marinho) e public/logo-light.svg (branco,
 * para fundos escuros) são gerados por `npm run logo` a partir da fonte do
 * logotipo (Brush Script MT), já convertida em caminhos vetoriais.
 */
export interface Props {
  /** Versão branca, para o rodapé e outros fundos escuros. */
  light?: boolean;
  /** Altura em px; a largura segue a proporção do logo. */
  height?: number;
  /** Carrega com prioridade (use no cabeçalho, que aparece em toda página). */
  eager?: boolean;
}
const { light = false, height = 44, eager = false } = Astro.props;
// Proporção largura/altura do logo gerado (ver viewBox de public/logo.svg).
const RATIO = 5.0;
const width = Math.round(height * RATIO);
---

<img
  class="logo"
  src={light ? '/logo-light.svg' : '/logo.svg'}
  alt="Rosolen Têxtil"
  width={width}
  height={height}
  style={`height:${height}px`}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : 'auto'}
/>

<style>
  .logo {
    display: block;
    width: auto;
    max-width: 100%;
  }
</style>
