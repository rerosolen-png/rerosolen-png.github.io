---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FabricCard from '../../components/FabricCard.astro';
import Cta from '../../components/Cta.astro';
import { breadcrumbSchema, articleSchema, formatDate } from '../../lib/seo';
import {
  getArticles,
  getFabrics,
  resolveFabrics,
  articleUrl,
  type Article,
} from '../../lib/content';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props {
  article: Article;
}
const { article } = Astro.props;
const { data } = article;
const { Content } = await render(article);

const related = resolveFabrics(data.relatedFabrics, await getFabrics()).slice(0, 4);
const url = articleUrl(article);
const crumbs = [
  { name: 'Início', href: '/' },
  { name: 'Guia de tecidos', href: '/guia/' },
  { name: data.title, href: url },
];
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.description}
  canonical={url}
  image={data.image?.src}
  imageAlt={data.imageAlt ?? data.title}
  ogType="article"
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
  jsonLd={[
    breadcrumbSchema(crumbs),
    articleSchema({
      headline: data.title,
      description: data.description,
      url,
      image: data.image?.src,
      datePublished: data.pubDate,
      dateModified: data.updatedDate,
    }),
  ]}
>
  <article class="container section article" style="padding-top: 2rem">
    <Breadcrumbs items={crumbs} />
    <header class="article__header">
      <span class="eyebrow">Guia de tecidos</span>
      <h1>{data.title}</h1>
      <p class="lead">{data.description}</p>
      <p class="article__meta">
        Publicado em <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
        {data.updatedDate && (
          <>
            {' '}
            · atualizado em{' '}
            <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time>
          </>
        )}{' '}
        · por Rosolen Têxtil
      </p>
      {data.image && (
        <figure class="article__media">
          <Image
            src={data.image}
            alt={data.imageAlt ?? data.title}
            width={1200}
            height={675}
            loading="eager"
            fetchpriority="high"
            format="webp"
          />
          {data.imageCredit && (
            <figcaption>
              Foto: {data.imageCredit.author} · {data.imageCredit.source} ·{' '}
              {data.imageCredit.license}
            </figcaption>
          )}
        </figure>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    {data.tags.length > 0 && (
      <p class="cluster article__tags">
        {data.tags.map((t) => (
          <span class="chip">{t}</span>
        ))}
      </p>
    )}

    {related.length > 0 && (
      <section class="article__related" aria-labelledby="rel-title">
        <h2 id="rel-title">Tecidos citados neste artigo</h2>
        <div class="grid grid--4">
          {related.map((f) => (
            <FabricCard fabric={f} />
          ))}
        </div>
      </section>
    )}

    <Cta />
  </article>
</BaseLayout>

<style>
  .article__header {
    max-width: 820px;
    margin-bottom: 2rem;
  }
  .article__meta {
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .article__media {
    margin: 1.5rem 0 0;
  }
  .article__media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .article__media figcaption {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: 0.5rem;
  }
  .article__tags {
    margin-top: 2rem;
  }
  .article__related {
    margin-top: 3rem;
  }
</style>
