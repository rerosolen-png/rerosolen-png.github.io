---
/**
 * Layout base: <head> completo para SEO, header, footer e botão de WhatsApp.
 *
 * Toda página passa por aqui. Os dados estruturados (JSON-LD) de Organização
 * e WebSite são injetados em todas as páginas; páginas específicas enviam
 * schemas adicionais (Product, Article, FAQPage, BreadcrumbList) via `jsonLd`.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../data/site';
import { pageTitle, absUrl, localBusinessSchema, websiteSchema } from '../lib/seo';

export interface Props {
  /** Título da página (sem o sufixo da marca). */
  title?: string;
  /** Meta description (120–165 caracteres). */
  description: string;
  /** Caminho canônico (padrão: URL atual). */
  canonical?: string;
  /** Imagem Open Graph (caminho absoluto ou relativo ao site). */
  image?: string;
  imageAlt?: string;
  /** Tipo Open Graph. */
  ogType?: 'website' | 'article' | 'product';
  /** Schemas adicionais (JSON-LD). */
  jsonLd?: Record<string, unknown>[];
  /** Impede indexação (ex.: página 404). */
  noindex?: boolean;
  /** Datas para artigos (Open Graph). */
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description,
  canonical,
  image = site.defaultOgImage,
  imageAlt = `${site.name} - ${site.tagline}`,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const fullTitle = pageTitle(title);
const canonicalUrl = canonical ? absUrl(canonical) : Astro.url.toString();
const ogImage = absUrl(image);

const schemas = [localBusinessSchema(), websiteSchema(), ...jsonLd];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}

    <meta name="theme-color" content="#1f3a5f" />
    <meta name="author" content={site.name} />
    <meta name="geo.region" content="BR-SP" />
    <meta name="geo.placename" content={site.address.city} />
    <meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />
    <meta name="ICBM" content={`${site.geo.latitude}, ${site.geo.longitude}`} />

    <!-- Open Graph -->
    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Ícones -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      Pular para o conteúdo
    </a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
